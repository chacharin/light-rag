  <data key="d1">organization</data>
  <data key="d2">หน่วยงานรัฐบาลที่มีหน้าที่ดูแลและจัดการราชการ โดยอาจมีระดับต่างๆ เช่น ระดับกรมและระดับกอง</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-004</data>
