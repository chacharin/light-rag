  <data key="d1">concept</data>
  <data key="d2">ขอบังคับเป็นบรรดาขอความที่ผู้มีอำนาจหน้าที่กำหนดให้งานควรกระทำตามอำนาจของกฎหมายที่ถูกบัญญัติให้ออกมา</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-007</data>
