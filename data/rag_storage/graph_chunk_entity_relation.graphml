  <data key="d1">content</data>
  <data key="d2">A regulation from the Prime Minister's Office of Thailand concerning various administrative processes, specifically referring to the management of information and correspondence.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="คลาวด์">
  <data key="d0">คลาวด์</data>
  <data key="d1">concept</data>
  <data key="d2">A technology for storing and accessing data and programs over the internet instead of on a local computer.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Microsoft Excel">
  <data key="d0">Microsoft Excel</data>
  <data key="d1">artifact</data>
  <data key="d2">A spreadsheet program developed by Microsoft that is used for calculations, graphing tools, pivot tables, and a macro programming language.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Google Sheets">
  <data key="d0">Google Sheets</data>
  <data key="d1">artifact</data>
  <data key="d2">A web-based application that allows users to create and format spreadsheets and simultaneously work with other people.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Apple Numbers">
  <data key="d0">Apple Numbers</data>
  <data key="d1">artifact</data>
  <data key="d2">A spreadsheet application developed by Apple Inc. that allows for creating tables, charts, and various types of data presentations.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ระบบสำรบรรณอิเล็กทรอนิกส์">
  <data key="d0">ระบบสำรบรรณอิเล็กทรอนิกส์</data>
  <data key="d1">method</data>
  <data key="d2">An electronic information management system used for the storage, retrieval, and management of electronic documents in government processes.&lt;SEP&gt;ระบบสำรบรรณอิเล็กทรอนิกส์เป็นระบบที่ใช้สำหรับการจัดการเอกสารและข้อมูลในรูปแบบอิเล็กทรอนิกส์เพื่อให้เกิดประสิทธิภาพในการเข้าถึงและจัดการข้อมูล</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-002</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ระเบียบสำรบรรณ พ.ศ. ๒๕๒๖">
  <data key="d0">ระเบียบสำรบรรณ พ.ศ. ๒๕๒๖</data>
  <data key="d1">content</data>
  <data key="d2">A specific regulation regarding document management established in 1983, as referenced in the text for its amendments and applications in context with the electronic information system.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ระเบียบสำรบรรณ (ฉบับที่ ๒) พ.ศ. ๒๕๔๘">
  <data key="d0">ระเบียบสำรบรรณ (ฉบับที่ ๒) พ.ศ. ๒๕๔๘</data>
  <data key="d1">content</data>
  <data key="d2">An amendment to the original document management regulation established in 2005, which modifies earlier regulations as stated in the input text.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ทะเบียนอิเล็กทรอนิกส์">
  <data key="d0">ทะเบียนอิเล็กทรอนิกส์</data>
  <data key="d1">other</data>
  <data key="d2">ทะเบียนอิเล็กทรอนิกส์เป็นเอกสารที่จัดเก็บในรูปแบบอิเล็กทรอนิกส์ ซึ่งสามารถถูกจัดทำโดยใช้โปรแกรมต่างๆ เช่น Microsoft Excel, Google Sheets, หรือ Apple Numbers</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-002</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ส่วนรำชกำร">
  <data key="d0">ส่วนรำชกำร</data>
  <data key="d1">organization</data>
  <data key="d2">ส่วนรำชกำรคือหน่วยงานภาครัฐที่มีหน้าที่ในการจัดการและดำเนินการเกี่ยวกับกิจกรรมและบริการสาธารณะ</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-002</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
