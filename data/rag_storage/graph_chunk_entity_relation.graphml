  <data key="d1">content</data>
  <data key="d2">Documents that are legal evidence used in judicial proceedings, which must be kept according to specific laws or regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
