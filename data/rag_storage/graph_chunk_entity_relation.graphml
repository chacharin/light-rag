  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ผู้ดูแล">
  <data key="d0">ผู้ดูแล</data>
  <data key="d1">person</data>
  <data key="d2">The entity refers to the administrator or person in charge of managing email addresses and document submissions.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-008</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
