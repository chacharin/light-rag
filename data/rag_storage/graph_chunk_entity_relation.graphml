  <data key="d7">1.0</data>
  <data key="d8">The regulation from 1983 replaced the earlier 1963 regulation governing documentation work.</data>
  <data key="d9">Replaced by</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-000</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="ระเบียบสํานักนายกรัฐมนตรี วาดวยงานสารบรรณ พ.ศ. ๒๕๒๖" target="ระเบียบสํานักนายกรัฐมนตรี วาดวยการลงชื่อในหนังสือราชการ พ.ศ. ๒๕๐๗">
  <data key="d7">1.0</data>
  <data key="d8">The regulation from 1983 replaced the regulation concerning the signing of official documents from 1964.</data>
  <data key="d9">Replaced by</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-000</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="ระเบียบสํานักนายกรัฐมนตรี วาดวยงานสารบรรณ พ.ศ. ๒๕๒๖" target="ระเบียบสํานักนายกรัฐมนตรี วาดวยการลงชื่อในหนังสือราชการ (ฉบับที่ ๒) พ.ศ. ๒๕๑๖">
  <data key="d7">1.0</data>
  <data key="d8">The regulation from 1983 replaced the second version concerning the signing of official documents from 1973.</data>
  <data key="d9">Replaced by</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-000</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="สวนราชการ" target="หนังสือภายใน">
  <data key="d7">1.0</data>
  <data key="d8">An internal document that is created or signed by a governmental body.</data>
  <data key="d9">issued by,relates to</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-003</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="สวนราชการ" target="ระดับกรม">
  <data key="d7">1.0</data>
  <data key="d8">Higher-level divisions within the government structure that encompass agencies or departments.</data>
  <data key="d9">includes,pertains to</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-003</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="สวนราชการ" target="ระดับกอง">
  <data key="d7">1.0</data>
  <data key="d8">Lower-level divisions that fall under the organization of a department.</data>
  <data key="d9">is part of,operates under</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-003</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="สวนราชการ" target="หมายเลขโทรศัพท">
  <data key="d7">1.0</data>
  <data key="d8">Each governmental body has a corresponding phone number for official communications.</data>
  <data key="d9">assigned to,has</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-003</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="สวนราชการ" target="หมายเลขภายในตูสาขา">
  <data key="d7">1.0</data>
  <data key="d8">The internal branch number is associated with the governmental body for directing communications.</data>
  <data key="d9">assigned to,belongs to</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-003</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="ปลัดสํานักนายกรัฐมนตรี">
  <data key="d7">1.0</data>
  <data key="d8">The Secretary of the Prime Minister's Office maintains oversight of the committee assigned to perform specific tasks by the government.</data>
  <data key="d9">maintains</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-001</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="คณะอนุกรรมการ">
  <data key="d7">1.0</data>
  <data key="d8">The committee includes subcommittees formed to manage specific duties assigned by the government.</data>
  <data key="d9">includes</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-001</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="คณะทำงาน">
  <data key="d7">1.0</data>
  <data key="d8">The committee includes working groups that are established to execute designated tasks.</data>
  <data key="d9">includes</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-001</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="เจาของเรื่อง">
  <data key="d7">1.0</data>
  <data key="d8">The individual or body responsible for the document is designated as belonging to or managed by the committee.</data>
  <data key="d9">manages,owns</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-002</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="สถานที่ราชการ">
  <data key="d7">1.0</data>
  <data key="d8">The committee is associated with a government office or place that is responsible for handling the documents.</data>
  <data key="d9">associated with</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-002</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="ภาคผนวก ๑">
  <data key="d7">1.0</data>
  <data key="d8">The appendix offers guidelines that the committee follows regarding document coding and numbering.</data>
  <data key="d9">provides guidelines for</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-002</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="คําขึ้นต้น">
  <data key="d7">1.0</data>
  <data key="d8">The salutation is employed by the committee based on the status of the document recipients.</data>
  <data key="d9">used by</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-002</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="คําลงท้าย">
  <data key="d7">1.0</data>
  <data key="d8">The closing phrase is utilized by the committee according to the status of document recipients.</data>
  <data key="d9">used by</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-002</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="คณะกรรมการ" target="ภาคผนวก ๒">
  <data key="d7">1.0</data>
  <data key="d8">The committee follows the guidelines specified in Appendix 2 related to document salutations and closings.</data>
  <data key="d9">follows guidelines from</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-002</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="ปลัดสํานักนายกรัฐมนตรี" target="คณะกรรมการพิจารณาปรับปรุงและพัฒนา">
  <data key="d7">1.0</data>
  <data key="d8">The Secretary of the Prime Minister's Office requests opinions from the Committee for Reviewing and Improving Regulations as part of the review process.</data>
  <data key="d9">requests opinion</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-001</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="ปลัดสํานักนายกรัฐมนตรี" target="หนังสือภายนอก">
  <data key="d7">1.0</data>
  <data key="d8">The Secretary of the Prime Minister's Office requires external documents to adhere to specified formats for official communications.</data>
  <data key="d9">requires</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-001</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
  <data key="d13"></data>
</edge>
<edge source="ปลัดสํานักนายกรัฐมนตรี" target="ระเบียบ">
  <data key="d7">1.0</data>
  <data key="d8">The Secretary of the Prime Minister's Office maintains compliance with the regulations governing administrative activities.</data>
  <data key="d9">maintains</data>
  <data key="d10">doc-06774247da1722a2a4938aa36ec173a4-chunk-001</data>
  <data key="d11">ระเบียบ26.pdf</data>
  <data key="d12">1788999857</data>
