  <data key="d0">ผูออกขอบังคับ</data>
  <data key="d1">person</data>
  <data key="d2">The individual responsible for issuing a formal declaration or order, typically within a governmental context.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
