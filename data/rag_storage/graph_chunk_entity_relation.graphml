  <data key="d1">concept</data>
  <data key="d2">The study of historical events, traditions, and evidence that must be preserved for future reference and academic research.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
