  <data key="d0">หนวยเก็บ</data>
  <data key="d1">organization</data>
  <data key="d2">หนวยเก็บ refers to the agency or department responsible for storing and managing official documents within the Thai government, ensuring adherence to record-keeping regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-019</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
