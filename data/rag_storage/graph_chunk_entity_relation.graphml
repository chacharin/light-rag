  <data key="d1">other</data>
  <data key="d2">This date marks the implementation start date of certain provisions in the regulation established in the 4th edition of the document.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-000</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
