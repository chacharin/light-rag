  <data key="d1">artifact</data>
  <data key="d2">A smaller standard size of paper measuring 148 × 210 millimeters, used for notes and various documents in office environments.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-029</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
