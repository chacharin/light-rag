<node id="Backup">
  <data key="d0">Backup</data>
  <data key="d1">method</data>
  <data key="d2">Backup is the process of creating a copy of data to protect against data loss, particularly in the context of electronic documents and emails.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
  <data key="d4">ระเบียบ64.pdf</data>
