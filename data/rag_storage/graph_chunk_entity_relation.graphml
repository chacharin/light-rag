  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="แถลงการณ">
  <data key="d0">แถลงการณ</data>
  <data key="d1">content</data>
  <data key="d2">An official statement made by governmental authorities to provide clarity on matters or events relevant to government operations, presented to inform the public clearly.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="หนังสือประชาสัมพันธ">
  <data key="d0">หนังสือประชาสัมพันธ</data>
  <data key="d1">content</data>
  <data key="d2">A type of publication used for public communication, which can include announcements, statements, and news, dictated by regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="รายงาน">
  <data key="d0">รายงาน</data>
  <data key="d1">content</data>
  <data key="d2">A document that reports findings or activities, often used in the context of governmental or organizational communication.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
