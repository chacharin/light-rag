  <data key="d0">พลเอก ประยุทธ์ จันทร์โอชา</data>
  <data key="d1">person</data>
  <data key="d2">A military officer and the current Prime Minister of Thailand, known for his role in the Thai government and policy-making.</data>
  <data key="d3">doc-d0942c9616f5726dfe051b81b1633316-chunk-000</data>
  <data key="d4">ระเบียบ60.pdf</data>
  <data key="d5">1788999667</data>
