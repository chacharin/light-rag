  <data key="d2">ปีเป็นหน่วยที่ใช้ในการวัดเวลา ซึ่งในกรณีนี้อิงตามปีพุทธศักราช</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-007</data>
