<node id="กลาง">
  <data key="d0">กลาง</data>
  <data key="d1">organization</data>
  <data key="d2">The entity signifies the central organization that coordinates correspondence and documentation within the public sector.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-008</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
