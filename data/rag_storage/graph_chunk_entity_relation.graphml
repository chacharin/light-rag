  <data key="d0">ง ราชกิจจานุเบกษา</data>
  <data key="d1">content</data>
  <data key="d2">A publication that includes official announcements and regulations in Thailand, issued on May 25, 2021.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ระเบียบสำนักงานนายกรัฐมนตรี">
