  <data key="d1">concept</data>
  <data key="d2">The standard paper weight specified for use in official documents, identified by its weight in grams per square meter.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-028</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
