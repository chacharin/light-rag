  <data key="d1">person</data>
  <data key="d2">The person whose signature appears on a formal document, affirming authenticity and authority.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ตำแหน่ง">
  <data key="d0">ตำแหน่ง</data>
  <data key="d1">concept</data>
  <data key="d2">The position or title held by a person, usually reflecting their role or authority in a formal capacity.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ขอความ">
  <data key="d0">ขอความ</data>
  <data key="d1">content</data>
  <data key="d2">The text refers to specific regulations and formal statements that must be published or communicated by government agencies in Thailand.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="วัน เดือน ปี">
  <data key="d0">วัน เดือน ปี</data>
  <data key="d1">data</data>
  <data key="d2">Refers to specific dates when statements or documents are issued, including day, month, and year in the Buddhist calendar.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ข่าว">
  <data key="d0">ข่าว</data>
  <data key="d1">content</data>
  <data key="d2">Refers to notifications or reports that government agencies consider appropriate to disseminate to the public.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
