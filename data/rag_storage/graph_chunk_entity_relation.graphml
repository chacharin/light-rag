  <data key="d0">พนักงานส่วนท้องถิ่น</data>
  <data key="d1">other</data>
  <data key="d2">Refers to local government employees in Thailand who work within local administrative bodies.</data>
  <data key="d3">doc-d0942c9616f5726dfe051b81b1633316-chunk-000</data>
  <data key="d4">ระเบียบ60.pdf</data>
