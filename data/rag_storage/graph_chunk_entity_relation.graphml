</node>
<node id="ระเบียบส ำนักนำยกรัฐมนตรี">
  <data key="d0">ระเบียบส ำนักนำยกรัฐมนตรี</data>
  <data key="d1">other</data>
  <data key="d2">ระเบียบส ำนักนำยกรัฐมนตรีคือชุดของกฎและข้อบังคับที่กำหนดขึ้นเพื่อควบคุมการดำเนินงานและการบริหารราชการในส่วนของรัฐบาล&lt;SEP&gt;Regulations issued by the Office of the Prime Minister concerning electronic documentation and management.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-002&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-004</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="หน่วยงานของรัฐ">
  <data key="d0">หน่วยงานของรัฐ</data>
  <data key="d1">organization</data>
  <data key="d2">An organization that is part of the government responsible for managing public affairs and services.&lt;SEP&gt;A governmental organization that is involved in the handling of official documents and email communications.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-003&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-011</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ข้อมูลข่าวสาร">
  <data key="d0">ข้อมูลข่าวสาร</data>
  <data key="d1">content</data>
  <data key="d2">Information relating to government activities, which is published and shared through electronic means.&lt;SEP&gt;ข้อมูลข่าวสาร หมายถึง ข้อมูลที่ถูกสร้างขึ้นและจัดเก็บเพื่อใช้ในการสื่อสารภายในหน่วยงานราชการ&lt;SEP&gt;Information received or generated within the context of governmental operations.&lt;SEP&gt;Information and data related to government affairs and official communications that are managed and preserved through electronic mail.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-003&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-005&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-006&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-011</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="การรับส่งและเก็บรักษาข้อมูล">
  <data key="d0">การรับส่งและเก็บรักษาข้อมูล</data>
  <data key="d1">method</data>
  <data key="d2">Procedures and practices for receiving, sending, and storing information related to government operations in an electronic format.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-003</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="การสำรองข้อมูล">
  <data key="d0">การสำรองข้อมูล</data>
  <data key="d1">method</data>
  <data key="d2">The process of creating copies of electronic documents to ensure information preservation.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-003</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="มาตรฐาน PDF">
  <data key="d0">มาตรฐาน PDF</data>
  <data key="d1">concept</data>
  <data key="d2">An established format for electronic documents that ensures uniformity and accessibility.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-003</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="หลักเกณฑ์และวิธีกำรปฏิบัติ">
  <data key="d0">หลักเกณฑ์และวิธีกำรปฏิบัติ</data>
  <data key="d1">method</data>
  <data key="d2">Guidelines and procedures for the transmission and archiving of information within government operations as established in official documents.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-003</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ภาคผนวก ๖">
  <data key="d0">ภาคผนวก ๖</data>
  <data key="d1">content</data>
  <data key="d2">An appendix referring to specific guidelines related to the management of electronic documents in government.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-003</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ภาคผนวก ๗">
  <data key="d0">ภาคผนวก ๗</data>
  <data key="d1">content</data>
  <data key="d2">An appendix that outlines further procedures and guidelines related to electronic document management and communication.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-003</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="หัวหน้ำส่วนรำชกำร">
  <data key="d0">หัวหน้ำส่วนรำชกำร</data>
  <data key="d1">organization</data>
  <data key="d2">The head of the governmental department responsible for electronic document management and record keeping.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-004</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="กรมศิลปำกร">
  <data key="d0">กรมศิลปำกร</data>
  <data key="d1">organization</data>
  <data key="d2">The Department of Fine Arts, a governmental organization involved in record management and historical documentation.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-004</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ปลัดส ำนักนำยกรัฐมนตรี">
  <data key="d0">ปลัดส ำนักนำยกรัฐมนตรี</data>
  <data key="d1">person</data>
  <data key="d2">The Secretary of the Office of the Prime Minister, responsible for implementing and maintaining regulatory compliance.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-004</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ส ำนักหอจดหมำยเหตุแห่งชำติ">
  <data key="d0">ส ำนักหอจดหมำยเหตุแห่งชำติ</data>
  <data key="d1">organization</data>
  <data key="d2">The National Archives, a governmental body that manages and preserves national historical records.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-004</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="หนังสือราชการ">
  <data key="d0">หนังสือราชการ</data>
  <data key="d1">content</data>
  <data key="d2">หนังสือราชการ เป็นเอกสารที่มีการสื่อสารระหว่างหน่วยงานราชการและอาจเป็นทางการหรือตามกฎข้อบังคับของราชการ&lt;SEP&gt;Official documents generated and used by government bodies for communication.&lt;SEP&gt;The entity refers to official letters or documents used for formal communication within government agencies.&lt;SEP&gt;Official documents issued by government departments or agencies in Thailand.&lt;SEP&gt;Government documents that serve as official evidence, covering various types of communications between government bodies and external entities.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-005&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-006&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-008&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-000&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-001</data>
  <data key="d4">ระเบียบ64.pdf&lt;SEP&gt;ระเบียบ26.pdf</data>
  <data key="d5">1788999851</data>
  <data key="d6"></data>
</node>
<node id="ผู้ใช้">
  <data key="d0">ผู้ใช้</data>
  <data key="d1">person</data>
  <data key="d2">ผู้ใช้ หมายถึง บุคคลที่มีสิทธิในการเปิด รับ หรือส่งหนังสือด้วยระบบสารบรรณอิเล็กทรอนิกส์</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-005</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="เจ้าหน้าที่">
  <data key="d0">เจ้าหน้าที่</data>
  <data key="d1">person</data>
  <data key="d2">เจ้าหน้าที่ refers to individuals assigned specific responsibilities within government agencies and organizations, primarily focusing on the management and administration of documentation and electronic communication systems. These staff members, often described as officials or personnel, play critical roles in the handling and processing of documents, emails, and general administrative tasks.

Their responsibilities include overseeing the use of electronic document management systems, responding to emails, and managing communication processes relevant to their roles. In essence, เจ้าหน้าที่ are integral to ensuring that documentation flows smoothly within their departments, handling tasks related to document forwarding, email communication, and various administrative functions in a systematic manner.

The entity encompasses various functions within a central document unit and other related administrative areas, reflecting their essential involvement in both processing documents and facilitating effective communication within government structures. Overall, เจ้าหน้าที่ are key players in the operational framework of governmental organizations, ensuring that administrative processes are carried out efficiently and effectively.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-005&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-006&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-008&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-010&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-011&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-015&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-016</data>
  <data key="d4">ระเบียบ64.pdf&lt;SEP&gt;ระเบียบ26.pdf</data>
  <data key="d5">1788999854</data>
  <data key="d6"></data>
</node>
<node id="หัวหน้าส่วนราชการ">
  <data key="d0">หัวหน้าส่วนราชการ</data>
  <data key="d1">person</data>
  <data key="d2">หัวหน้าส่วนราชการ หมายถึง บุคคลที่มีอำนาจในการมอบหมายงานและกำกับดูแลการปฏิบัติงานในส่วนราชการ&lt;SEP&gt;The head of a governmental department who oversees operations and regulations.&lt;SEP&gt;บุคคลที่มีหน้าที่รับผิดชอบในการลงชื่อในหนังสือประทับตราและดูแลการจัดการของส่วนราชการระดับกรมขึ้นไป&lt;SEP&gt;The head of a governmental department responsible for authorizing actions related to public records and documentation.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-005&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-006&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-004&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ64.pdf&lt;SEP&gt;ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ข้อมูลรักษาความลับ">
  <data key="d0">ข้อมูลรักษาความลับ</data>
  <data key="d1">data</data>
  <data key="d2">ข้อมูลรักษาความลับ หมายถึง ข้อมูลหรือเอกสารที่จำเป็นต้องเก็บรักษาเป็นความลับภายใต้กฎหมายหรือข้อบังคับของราชการ</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-005</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="หลักเกณฑ์และวิธีการ">
  <data key="d0">หลักเกณฑ์และวิธีการ</data>
  <data key="d1">concept</data>
  <data key="d2">หลักเกณฑ์และวิธีการ หมายถึง แนวทางและวิธีการที่ใช้ในการดำเนินการต่าง ๆ ในระบบสารบรรณอิเล็กทรอนิกส์</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-005</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="วันและเวลา">
  <data key="d0">วันและเวลา</data>
  <data key="d1">other</data>
  <data key="d2">วันและเวลา หมายถึง ข้อมูลที่ระบุวันและเวลาที่เกี่ยวข้องกับการรับส่งข้อมูลข่าวสารหรือหนังสือในระบบสารบรรณอิเล็กทรอนิกส์&lt;SEP&gt;The date and time when the document is received by the recipient.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-005&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-017</data>
  <data key="d4">ระเบียบ64.pdf&lt;SEP&gt;ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ส่วนราชการ">
  <data key="d0">ส่วนราชการ</data>
  <data key="d1">organization</data>
  <data key="d2">A governmental or administrative body responsible for specific functions or services.&lt;SEP&gt;The entity refers to government agencies responsible for handling official documents and communications.&lt;SEP&gt;A government body involved in administrative tasks related to email communications and document management.&lt;SEP&gt;A government agency or division responsible for official matters and documentation within a formal organizational structure.&lt;SEP&gt;Refers to the government departments or agencies that issue statements or documents.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-006&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-008&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-011&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ64.pdf&lt;SEP&gt;ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="อีเมล">
  <data key="d0">อีเมล</data>
  <data key="d1">content</data>
  <data key="d2">An electronic mail system used for communication and information exchange within government departments.&lt;SEP&gt;An electronic message used for communication, which may contain confidential or privileged information and requires the recipient to acknowledge receipt.&lt;SEP&gt;An electronic mail message that can be sent and received within the organization, containing official communications.&lt;SEP&gt;The entity refers to electronic mail used for communication and document transmission among officials and agencies.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-006&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-008&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-010&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-011</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="ลายมือชื่ออิเล็กทรอนิกส์">
  <data key="d0">ลายมือชื่ออิเล็กทรอนิกส์</data>
  <data key="d1">artifact</data>
  <data key="d2">A digital signature used to authenticate official documents transmitted via email.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-006</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="วิธีการ">
  <data key="d0">วิธีการ</data>
  <data key="d1">concept</data>
  <data key="d2">The methods or procedures established for specific actions within governmental processes, including communication and document handling.&lt;SEP&gt;The specified procedures or techniques outlined for carrying out actions related to email and document management in government operations.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-006&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-011</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Junk Mail">
  <data key="d0">Junk Mail</data>
  <data key="d1">content</data>
  <data key="d2">Junk Mail refers to unsolicited or unwanted emails that should not be opened or responded to.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Hoax Mail">
  <data key="d0">Hoax Mail</data>
  <data key="d1">content</data>
  <data key="d2">Hoax Mail is a type of junk mail that may contain deceptive information or scams.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Email">
  <data key="d0">Email</data>
  <data key="d1">other</data>
  <data key="d2">Email is a method of exchanging digital messages between people using electronic devices.&lt;SEP&gt;A method of communication used to send documents and information electronically, as instructed in the text.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007&lt;SEP&gt;doc-ceedf5011eea7c7360657197d99b802c-chunk-009</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Central Document Department">
  <data key="d0">Central Document Department</data>
  <data key="d1">organization</data>
  <data key="d2">The Central Document Department is responsible for handling emails from external sources and managing document registration and responses.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Prime Ministers Office">
  <data key="d0">Prime Ministers Office</data>
  <data key="d1">organization</data>
  <data key="d2">The Prime Minister's Office is the executive office of the Prime Minister and oversees various governmental functions, including document management protocols.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Document Registration#">
  <data key="d0">Document Registration#</data>
  <data key="d1">method</data>
  <data key="d2">Document registration is the process of formally recording documents received via email according to established regulations.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Email Response">
  <data key="d0">Email Response</data>
  <data key="d1">method</data>
  <data key="d2">Email response involves replying to received emails, confirming their receipt and providing necessary details as per protocol.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Confidential Document">
  <data key="d0">Confidential Document</data>
  <data key="d1">other</data>
  <data key="d2">Confidential documents are sensitive communications that require special handling and security measures during their management.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
  <data key="d4">ระเบียบ64.pdf</data>
  <data key="d5">1788999789</data>
  <data key="d6"></data>
</node>
<node id="Government Regulations">
  <data key="d0">Government Regulations</data>
  <data key="d1">concept</data>
  <data key="d2">Government regulations are rules and standards established by governmental agencies for managing various processes, including document handling and security.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-007</data>
