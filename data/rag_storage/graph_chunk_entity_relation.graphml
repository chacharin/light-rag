  <data key="d0">หัวข้อการประชุม</data>
  <data key="d1">concept</data>
  <data key="d2">หัวข้อการประชุมคือเรื่องที่ถูกนำเสนอและหารือในที่ประชุม โดยประกอบด้วยสาระสำคัญและมติที่เกิดขึ้น</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="เอกสารอื่น">
  <data key="d0">เอกสารอื่น</data>
  <data key="d1">content</data>
  <data key="d2">เอกสารอื่นเป็นหนังสือหรือเอกสารที่จัดทำขึ้นเกี่ยวกับการปฏิบัติงานของเจ้าหน้าที่ ซึ่งอาจรวมถึงภาพถ่ายหรือฟิล์มที่เกี่ยวข้อง</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
