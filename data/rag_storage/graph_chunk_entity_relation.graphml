  <data key="d0">กองจดหมายเหต ุแหงชาติ</data>
  <data key="d1">organization</data>
  <data key="d2">กองจดหมายเหต ุแหงชาติ is the national archive department in Thailand, which handles the collection and preservation of historical records and documents.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-021</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
