<node id="หน่วยงาน">
  <data key="d0">หน่วยงาน</data>
  <data key="d1">organization</data>
  <data key="d2">The entity represents various departments or organizations within the government that manage specific tasks or duties.&lt;SEP&gt;An organizational unit or agency, often part of the government, that plays a role in formal processes and documentation.</data>
  <data key="d3">doc-ceedf5011eea7c7360657197d99b802c-chunk-008&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
