  <data key="d0">๒๕๔๘</data>
  <data key="d1">other</data>
  <data key="d2">๒๕๔๘ refers to the year 2005 in the Buddhist calendar, which is used in Thailand.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-027</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ตรา">
  <data key="d0">ตรา</data>
  <data key="d1">artifact</data>
  <data key="d2">An official seal used for imprinting on documents, which holds significance in determining retention periods.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-028</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="กระดาษ">
  <data key="d0">กระดาษ</data>
  <data key="d1">artifact</data>
  <data key="d2">Paper materials referred to for various sizes and weights used in official documents and seals.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-028</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
