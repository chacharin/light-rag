  <data key="d2">A certificate issued by government authorities to certify individuals, legal entities, or organizations for specific purposes.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
