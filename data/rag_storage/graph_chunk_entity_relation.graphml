  <data key="d1">content</data>
  <data key="d2">หนังสือเก็บไว refers to official documents that are retained for various periods based on regulatory guidelines in Thailand, indicating their importance for future reference.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-019</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
