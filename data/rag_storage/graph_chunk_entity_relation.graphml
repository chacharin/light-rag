  <data key="d0">หน่วยงานราชการ</data>
  <data key="d1">organization</data>
  <data key="d2">องค์กรมหาชนที่มีหน้าที่ในการบริหารราชการภายในประเทศ</data>
  <data key="d3">doc-24ac77f7076fc10b9cb95f7b3b0d316c-chunk-003</data>
  <data key="d4">ระเบียบ48.pdf</data>
