  <data key="d1">concept</data>
  <data key="d2">National security measures and regulations that govern the handling of sensitive documents and information.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
