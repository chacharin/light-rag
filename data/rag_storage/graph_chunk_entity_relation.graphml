  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ประกาศ">
  <data key="d0">ประกาศ</data>
  <data key="d1">content</data>
  <data key="d2">A formal announcement made by government authorities to declare or clarify information, providing guidelines or practices to be followed, typically printed on official letterhead.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-008&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-031</data>
