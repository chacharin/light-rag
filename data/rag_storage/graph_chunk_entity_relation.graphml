</node>
<node id="ขนาดดีแอล">
  <data key="d0">ขนาดดีแอล</data>
  <data key="d1">concept</data>
  <data key="d2">Referring to another envelope size suitable for holding letters or documents, often denoted in document management processes.&lt;SEP&gt;Refers to a paper size of 110 mm × 220 mm, designated in official standards.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-028&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-029</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="มิลลิเมตร">
  <data key="d0">มิลลิเมตร</data>
  <data key="d1">data</data>
  <data key="d2">The unit of measurement expressed in millimeters, commonly used for measuring dimensions and sizes in various contexts, including paper sizes.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-029</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
