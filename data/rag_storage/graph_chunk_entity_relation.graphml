  <data key="d1">person</data>
  <data key="d2">A former Prime Minister of Thailand known for his influential role in Thai politics.</data>
  <data key="d3">doc-24ac77f7076fc10b9cb95f7b3b0d316c-chunk-006</data>
  <data key="d4">ระเบียบ48.pdf</data>
  <data key="d5">1788999703</data>
  <data key="d6"></data>
</node>
<node id="ปีพุทธศักราช">
  <data key="d0">ปีพุทธศักราช</data>
  <data key="d1">data</data>
  <data key="d2">A Buddhist Era year used in Thailand, correlating to the traditional Thai calendar system.&lt;SEP&gt;A calendar system used in Thailand that is known as the Buddhist Era.&lt;SEP&gt;The Buddhist Era year that should be included in formal documents to specify the year of issuance or occurrence of an event.</data>
  <data key="d3">doc-24ac77f7076fc10b9cb95f7b3b0d316c-chunk-006&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-006&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ48.pdf&lt;SEP&gt;ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="วันที่จัดทำบัญชี">
  <data key="d0">วันที่จัดทำบัญชี</data>
  <data key="d1">other</data>
  <data key="d2">The specific date when the account or record is officially created or compiled.</data>
  <data key="d3">doc-24ac77f7076fc10b9cb95f7b3b0d316c-chunk-006</data>
  <data key="d4">ระเบียบ48.pdf</data>
  <data key="d5">1788999703</data>
