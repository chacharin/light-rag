  <data key="d0">ขนาดซี 4</data>
  <data key="d1">other</data>
  <data key="d2">A specific size of envelope or paper that allows accommodation for documents without folding, typical measurements being 229 × 324 millimeters.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-029</data>
  <data key="d4">ระเบียบ26.pdf</data>
