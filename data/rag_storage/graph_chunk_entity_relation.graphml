  <data key="d0">การเก็บไวเพื่อใชในการตรวจสอบ</data>
  <data key="d1">concept</data>
  <data key="d2">An abstract procedure for retaining documents for ongoing verification, necessary for compliance with regulations related to document handling and storage.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-020</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
