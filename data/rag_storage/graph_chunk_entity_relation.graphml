  <data key="d1">concept</data>
  <data key="d2">Refers to a paper size of 52 mm × 74 mm, designated in official standards.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-028</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
