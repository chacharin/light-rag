</node>
<node id="บัญชีหนังสือครบ ๒๕ ป">
  <data key="d0">บัญชีหนังสือครบ ๒๕ ป</data>
  <data key="d1">content</data>
  <data key="d2">A record of documents or books that are maintained over a period of 25 years as per the regulations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-022</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="กองจดหมายเหตุแห่งชาติ">
  <data key="d0">กองจดหมายเหตุแห่งชาติ</data>
  <data key="d1">organization</data>
  <data key="d2">The National Archives section that handles the preservation of important documents and records in Thailand.&lt;SEP&gt;กองจดหมายเหตุแห่งชาติเป็นหน่วยงานที่รับผิดชอบในการเก็บรักษาเอกสารและหนังสือสำคัญจากรัฐ</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-022&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-030</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="กระทรวง ทบวง กรม กอง">
  <data key="d0">กระทรวง ทบวง กรม กอง</data>
  <data key="d1">organization</data>
  <data key="d2">An entity representing a governmental department responsible for forms and documentation management in the context of administrative processes.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="หนังสือที่ฝากเก็บไว">
  <data key="d0">หนังสือที่ฝากเก็บไว</data>
  <data key="d1">content</data>
  <data key="d2">A document that is stored with the National Archives Office, regarded as official and relevant for the department that deposited it.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ผู้ฝาก">
  <data key="d0">ผู้ฝาก</data>
  <data key="d1">person</data>
  <data key="d2">A person responsible for depositing documents at the National Archives Office, required to sign and provide details for record-keeping.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ผู้รับฝาก">
  <data key="d0">ผู้รับฝาก</data>
  <data key="d1">person</data>
  <data key="d2">A person who receives documents on behalf of a department, required to sign and provide their name and position for record-keeping.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-023</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="การยืม">
  <data key="d0">การยืม</data>
  <data key="d1">concept</data>
  <data key="d2">The concept of borrowing documents within government agencies, including procedures and requirements for individuals who wish to lend or borrow materials.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ผูยืม">
  <data key="d0">ผูยืม</data>
  <data key="d1">person</data>
  <data key="d2">An individual who borrows documents from a government agency and is required to provide certain information and fulfill specific conditions.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="เจาหน้าที่เก็บ">
  <data key="d0">เจาหน้าที่เก็บ</data>
  <data key="d1">person</data>
  <data key="d2">An official responsible for managing the lending process of documents and ensuring proper documentation of such transactions.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="หัวหนาสวนราชการ">
  <data key="d0">หัวหนาสวนราชการ</data>
  <data key="d1">person</data>
  <data key="d2">A senior official in a government department who has the authority to approve document loans within their section or department.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="บัตรยืมหนังสือ">
  <data key="d0">บัตรยืมหนังสือ</data>
  <data key="d1">data</data>
  <data key="d2">A borrowing card used to track the details of borrowed books, including the borrower's information and the status of the loan.&lt;SEP&gt;A borrowing card used as evidence for books lent out, characterized by A4 size and printed on one side.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-031</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="เอกสารสิทธิตามกฎหมาย">
  <data key="d0">เอกสารสิทธิตามกฎหมาย</data>
  <data key="d1">concept</data>
  <data key="d2">Documents that signify legal rights as established by law, which may include important papers that need to be reported if lost.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="พนักงานสอบสวน">
  <data key="d0">พนักงานสอบสวน</data>
  <data key="d1">person</data>
  <data key="d2">An investigator or officer responsible for handling cases, especially those related to lost or damaged legal documents, and for processing related reports.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-024</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="บัญชีหนังสือขอทําลาย">
  <data key="d0">บัญชีหนังสือขอทําลาย</data>
  <data key="d1">content</data>
  <data key="d2">A formal document accounting for books requested for destruction, required to have details such as year, responsible agency signature, and a list of books.&lt;SEP&gt;The list of documents that are proposed for destruction, which the committee reviews to make their evaluations.&lt;SEP&gt;A record used to list books that have reached the retention period, characterized by A4 size and printed on both sides.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-026&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-031</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="การทําลาย">
  <data key="d0">การทําลาย</data>
  <data key="d1">method</data>
  <data key="d2">The process of destroying books that are no longer needed, which includes regulations and protocols to be followed.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="คณะกรรมการทําลายหนังสือ">
  <data key="d0">คณะกรรมการทําลายหนังสือ</data>
  <data key="d1">organization</data>
  <data key="d2">A committee established to oversee the destruction of books, composed of a chairperson and additional members.&lt;SEP&gt;A committee responsible for the destruction of documents, tasked with evaluating whether to destroy books and making recommendations on their retention or destruction.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-026</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="เจาหนาที่ผูรับผิดชอบ">
  <data key="d0">เจาหนาที่ผูรับผิดชอบ</data>
  <data key="d1">person</data>
  <data key="d2">An appointed official responsible for ensuring adherence to regulations regarding the maintenance and destruction of books.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="การยืมหนังสือ">
  <data key="d0">การยืมหนังสือ</data>
  <data key="d1">method</data>
  <data key="d2">The process of borrowing books, which involves rules for lending and restrictions on access for outside individuals.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="การตรวจสอบ">
  <data key="d0">การตรวจสอบ</data>
  <data key="d1">method</data>
  <data key="d2">The process for reviewing documents or records, generally associated with maintaining accuracy and compliance.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-025</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="หัวหนาสวนราชการระดับกรม">
  <data key="d0">หัวหนาสวนราชการระดับกรม</data>
  <data key="d1">person</data>
  <data key="d2">The head of a governmental division, responsible for appointing committees and making decisions based on their recommendations regarding document destruction.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-026</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="การพิจารณา">
  <data key="d0">การพิจารณา</data>
  <data key="d1">concept</data>
  <data key="d2">The process by which the committee evaluates documents to determine whether they should be destroyed or retained.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-026</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="บันทึกความเห็นแยง">
  <data key="d0">บันทึกความเห็นแยง</data>
  <data key="d1">content</data>
  <data key="d2">Records of dissenting opinions that the committee members may submit regarding decisions on document destruction.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-026</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="กันยายน">
  <data key="d0">กันยายน</data>
  <data key="d1">other</data>
  <data key="d2">กันยายน is the name of the month of September in the Gregorian calendar used in Thailand.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-027</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
