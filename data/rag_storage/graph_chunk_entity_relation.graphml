  <data key="d6"></data>
</node>
<node id="รายงานการประชุม">
  <data key="d0">รายงานการประชุม</data>
  <data key="d1">content</data>
  <data key="d2">A report that summarizes discussions and decisions made during formal meetings of government agencies.&lt;SEP&gt;รายงานการประชุมเป็นเอกสารที่บันทึกผลการประชุม รวมถึงมติและข้อมูลเกี่ยวกับคนที่เข้าร่วมประชุม</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="นิติบุคคล">
  <data key="d0">นิติบุคคล</data>
  <data key="d1">concept</data>
  <data key="d2">A legal entity (such as a corporation) that is recognized by law, which requires clear identification in official documentation.&lt;SEP&gt;Legal entities recognized by law as individuals in lawsuits and for contractual obligations.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="เลขที่">
  <data key="d0">เลขที่</data>
  <data key="d1">data</data>
  <data key="d2">A unique number assigned to documents such as certificates or official letters for tracking and reference.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="หลักฐาน">
  <data key="d0">หลักฐาน</data>
  <data key="d1">content</data>
  <data key="d2">Refers to the documents or evidence maintained by government agencies to substantiate their actions or decisions in legal or administrative contexts.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="หนังสืออื่น">
  <data key="d0">หนังสืออื่น</data>
  <data key="d1">content</data>
  <data key="d2">Refers to other types of documents that are not categorized under specific types like certificates or reports but are still part of the documentation process within government agencies.&lt;SEP&gt;Document or evidence resulting from official duties of officials, including photographs, films, audio recordings, video recordings, etc.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-009&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-012</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="บุคคล">
  <data key="d0">บุคคล</data>
  <data key="d1">person</data>
  <data key="d2">An individual person whose full name and position need to be stated clearly in formal documents.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="การประชุม">
  <data key="d0">การประชุม</data>
  <data key="d1">event</data>
  <data key="d2">A formal gathering of individuals to discuss and record opinions and resolutions, resulting in an official meeting report.&lt;SEP&gt;การประชุมเป็นกิจกรรมที่มีการรวมกลุ่มบุคคลเพื่อหารือหรือดำเนินการเรื่องต่าง ๆ ตามระเบียบที่กำหนดไว้</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010&lt;SEP&gt;doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="คณะที่ประชุม">
  <data key="d0">คณะที่ประชุม</data>
  <data key="d1">other</data>
  <data key="d2">The assembly or group of individuals participating in a meeting, often recognized in the official reports and documentation.</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-010</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ผูบังคับบัญชา">
  <data key="d0">ผูบังคับบัญชา</data>
  <data key="d1">person</data>
  <data key="d2">ผูบังคับบัญชาเป็นบุคคลที่มีอำนาจในการสั่งการและดูแลผู้ใต้บังคับบัญชา ในการประชุมจะทำการสั่งการหรือตัดสินใจในเรื่องสำคัญ</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
  <data key="d6"></data>
</node>
<node id="ผูใตบังคับบัญชา">
  <data key="d0">ผูใตบังคับบัญชา</data>
  <data key="d1">person</data>
  <data key="d2">ผูใตบังคับบัญชาเป็นบุคคลที่ทำงานภายใต้การนำของผูบังคับบัญชา โดยอาจเสนอความคิดเห็นหรือรายงานในที่ประชุม</data>
  <data key="d3">doc-06774247da1722a2a4938aa36ec173a4-chunk-011</data>
  <data key="d4">ระเบียบ26.pdf</data>
  <data key="d5">1788999852</data>
